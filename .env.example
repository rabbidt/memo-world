# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/ (Settings > API keys).
ANTHROPIC_API_KEY=

# Hard monthly spend cap in US dollars. Memo sleeps when it is reached.
MEMO_MONTHLY_CAP_USD=10

# Minutes between Memo's thoughts (10 to 15 is a good range).
MEMO_TICK_MINUTES=12

# Models. The cheap one runs every tick, the strong one crafts and reflects.
MEMO_TICK_MODEL=claude-haiku-5-5
MEMO_DEEP_MODEL=claude-sonnet-5-5

# How many things Memo may craft per day (each craft uses the strong model).
MEMO_CRAFTS_PER_DAY=2

# Memo's bedtime and wake time, in this computer's local time (24h, HH:MM).
MEMO_BEDTIME=22:00
MEMO_WAKETIME=06:30

# Web page address. Keep 127.0.0.1 to allow only this computer.
# Use 0.0.0.0 to let other devices on your home network watch too.
HOST=127.0.0.1
PORT=4477

# Set to 1 to run without the API (Memo wanders on simple instincts, free).
MEMO_DEMO=0

# Town building: how many big building plans Memo may draw up per day.
MEMO_PROJECTS_PER_DAY=1

# Memo's computer. Apps are switched on and off from the Keeper tab on the page.
# The browser app is a read-only web search (about 1 cent per search).
MEMO_WEB_SESSIONS_PER_DAY=3

# When Memo may send you a message, and how many per day.
MEMO_KEEPER_TZ=Europe/London
MEMO_KEEPER_FROM_HOUR=9
MEMO_KEEPER_TO_HOUR=21
MEMO_MESSAGES_PER_DAY=3
# Optional: get Memo's messages on your phone. Install the free ntfy app,
# pick a hard-to-guess topic name, and put https://ntfy.sh/your-topic here.
MEMO_NOTIFY_URL=

# Memo's computer can also ask Claude questions (counts toward the cap).
MEMO_CLAUDE_CHATS_PER_DAY=2

# Memo's workshop: little programs and games he writes (each uses the strong model).
MEMO_PROGRAMS_PER_DAY=1
# Optional: save his programs to his own GitHub repo. Create an empty repo such as
# yourname/memo-workshop, then a fine-grained token that can reach ONLY that repo with
# "Contents: read and write". Memo's programs never run on this computer either way.
MEMO_GITHUB_REPO=
MEMO_GITHUB_TOKEN=

# Free Wikipedia look-ups, and longer writing in his text editor, per day.
MEMO_WIKI_LOOKUPS_PER_DAY=6
MEMO_DOCUMENTS_PER_DAY=2

# Memo's library. Put .epub, .txt or .md books in this folder (default: the books
# folder next to this file). He reads a few pages at a time and keeps his place.
MEMO_BOOKS_DIR=
MEMO_READINGS_PER_DAY=5

# How much living it takes for Memo to be fully grown (he never grows old).
MEMO_ADULT_XP=9000
